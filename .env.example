# Supabase → Project Settings.
# Data API → Project URL, y API Keys → publishable (NO la service_role).
NEXT_PUBLIC_SUPABASE_URL=https://ltysyhwyzqbumvdpumxq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional, y sólo para las llamadas de WhatsApp.
#
# Los servidores STUN que le dicen al navegador cuál es su dirección vista
# desde afuera. Sin esto se usan los públicos de Google, que alcanzan en una
# red normal. Sólo hay que tocarlo si en alguna oficina las llamadas se
# conectan sin que se escuche a nadie: ahí hace falta un TURN.
#
# Es pública a propósito —la necesita el navegador—, así que NO debe llevar
# credenciales de un TURN pago. Varias, separadas por coma.
# NEXT_PUBLIC_ICE_SERVERS=stun:stun.l.google.com:19302
